
generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "sqlite"
}

model Anggota {
  id      Int       @id @default(autoincrement())
  nama    String
  divisi  String
  status  String
  absensi Absensi[]

  @@map("anggota")
}

model Absensi {
  id         Int      @id @default(autoincrement())
  anggotaId  Int
  tanggal    String
  keterangan String

  anggota Anggota @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@map("absensi")
}
